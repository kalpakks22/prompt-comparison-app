# ================= Provider =================
# One of: openai | gemini | anthropic | ollama
# Comma-separate to compare across providers, e.g. openai,gemini,ollama
# "ollama" runs against a locally hosted model (no API key needed)
LLM_PROVIDER=ollama

# ================= OpenAI (Responses API) =================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional, reasoning models only: minimal | low | medium | high
OPENAI_REASONING_EFFORT=
OPENAI_INPUT_PRICE_PER_1M=
OPENAI_OUTPUT_PRICE_PER_1M=

# ================= Google Gemini (google-genai) =================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INPUT_PRICE_PER_1M=
GEMINI_OUTPUT_PRICE_PER_1M=

# ================= Anthropic (Messages API) =================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_INPUT_PRICE_PER_1M=
ANTHROPIC_OUTPUT_PRICE_PER_1M=

# ================= Ollama (local) =================
# URL of your locally running Ollama server
OLLAMA_BASE_URL=http://localhost:11434
# Model must already be pulled, e.g.: ollama run qwen2.5-coder:3b
OLLAMA_MODEL=qwen2.5-coder:3b

# ================= Generation settings =================
MAX_OUTPUT_TOKENS=1024
# Leave empty to use the model default (some reasoning models reject temperature)
TEMPERATURE=

# ================= Prompts =================
# File names (without .md) inside PROMPT_DIR
PROMPT_DIR=prompts
PROMPT_1_NAME=unstructured_prompt
PROMPT_2_NAME=structured_prompt

# ================= Task input =================
# Try NUM_B=abc to see the early-exit rule in action
NUM_A=25
NUM_B=17

# ================= Repeatability test =================
# How many times repeatability_test.py runs Prompt 1 and Prompt 2
REPEAT_COUNT=10
